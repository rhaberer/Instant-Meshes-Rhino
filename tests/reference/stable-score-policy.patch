+// Diagnostic equivalent of the managed stable-area policy.
+static void regularize_unordered_areas(const AdjacencyMatrix adj, const MatrixXf &N, VectorXf &A) {
+    int firstSign = 0;
+    bool ambiguous = false;
+    for (int i = 0; i < N.cols() && !ambiguous; ++i) {
+        for (const Link *link = adj[i]; link != adj[i + 1]; ++link) {
+            uint32_t j = link->id;
+            if (A[i] > 0 && A[j] > 0)
+                continue;
+            __int128 dot = fixed_hierarchy_dot_raw(N.col(i), N.col(j));
+            int sign = (dot > 0) - (dot < 0);
+            if ((A[i] == 0 && A[j] == 0) || sign == 0 || (firstSign != 0 && sign != firstSign)) {
+                ambiguous = true;
+                break;
+            }
+            firstSign = sign;
+        }
+    }
+    if (!ambiguous)
+        return;
+    for (int i = 0; i < N.cols(); ++i) {
+        for (const Link *link = adj[i]; link != adj[i + 1]; ++link) {
+            A[i] = std::max(A[i], 1e-6f);
+            A[link->id] = std::max(A[link->id], 1e-6f);
+        }
+    }
+}
